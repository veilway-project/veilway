		},
		{
			"tag": "sink",
			"backend": {"type": "block"}
		}
	],
	"routing": {
		"default": "main",
		"rules": [
			{"tag": "gaming-lan", "inbound": ["gaming"], "ip": ["tunnel:gaming"], "action": "user"},
			{"tag": "isolate-users", "ip": ["tunnel:users"], "action": "reject"},
			{"tag": "no-private", "ip": ["geoip:private"], "action": "reject"},
			{"tag": "no-smtp", "protocol": ["tcp"], "port": [25, "465-587"], "action": "reject"},
			{"tag": "guest-no-quic", "enabled": false, "group": ["guest"], "protocol": ["udp"], "port": [443], "action": "reject"},
			{"tag": "staff-intranet", "group": ["staff"], "domain": ["intranet.example.com", "*.corp.example.com"], "action": {"exit": "node"}},
			{"tag": "staff-ping", "group": ["staff"], "protocol": ["icmp", "icmpv6"], "action": {"exit": "node"}},
			{"tag": "office-own-exit", "inbound": ["office"], "action": "user"}
		]
	},
	"users": [
