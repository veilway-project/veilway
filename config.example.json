	"exits": [
		{
			"tag": "main",
			"name": "Main",
			"country": "NL",
			"backend": {"type": "netstack", "outbound": "proxy", "tcp_idle_secs": 7200, "udp_idle_secs": 60, "unsupported": {"icmp_echo": "local", "udp": "reject", "other": "reject"}}
		},
		{
			"tag": "open",
			"name": "Unproxied",
			"backend": {"type": "netstack", "outbound": "plain"}
