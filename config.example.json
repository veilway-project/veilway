				{"name": "phone", "public_key": "IiIiIiIiIiIiIiIiIiIiIiIiIiIiIiIiIiIiIiIiIiI=", "preshared_key": "MTExMTExMTExMTExMTExMTExMTExMTExMTExMTExMTE=", "addresses": ["10.7.0.3", "10.9.0.3"]}
