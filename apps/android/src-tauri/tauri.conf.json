{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Veilway",
  "version": "0.2.12",
  "identifier": "io.github.veilwayproject.app",
  "build": {
    "frontendDist": "../../desktop/ui/dist",
    "devUrl": "http://127.0.0.1:5175",
    "beforeDevCommand": "npm --prefix ../desktop/ui run dev",
    "beforeBuildCommand": "npm --prefix ../desktop/ui ci && npm --prefix ../desktop/ui run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Veilway",
        "backgroundColor": "#111C21"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png"],
    "shortDescription": "Veilway for Android",
    "longDescription": "Connects to a Veilway node and routes all traffic of the device through it.",
    "android": {
      "minSdkVersion": 26
    }
  }
}
