{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Veilway",
  "version": "0.1.0",
  "identifier": "io.github.veilway-project.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Veilway",
        "width": 420,
        "height": 640,
        "minWidth": 360,
        "minHeight": 420,
        "resizable": true,
        "maximizable": false,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#111C21"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc0RjY2QTY2QTFGMUU2RTYKUldUbTV2R2habXIyZExjakVORUhkSG1TS3Y4MlNRK3pneGV1N3lXVEhZd0FnZFRlNUFYV0hiTWcK",
      "endpoints": ["https://github.com/veilway-project/veilway/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "shortDescription": "WireGuard client that tunnels over WSS",
    "longDescription": "Connects to a Veilway relay over WebSocket TLS and routes all traffic through it."
  }
}
