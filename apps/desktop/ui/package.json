{
	"name": "@veilway/desktop-ui",
	"version": "0.3.12",
	"private": true,
	"description": "The Veilway desktop app's window, loaded by the Tauri shell",
	"license": "Apache-2.0",
	"type": "module",
	"engines": {
		"node": ">=22.18"
	},
	"scripts": {
		"dev": "vite --host 127.0.0.1",
		"mock": "vite --mode mock --host 0.0.0.0",
		"build": "vite build",
		"build:mock": "vite build --mode mock --outDir dist-mock",
		"check": "tsc --noEmit"
	},
	"dependencies": {
		"@tauri-apps/api": "^2.9.0",
		"@veilway/i18n": "file:../../../../veilway-ui/packages/i18n",
		"@veilway/ui": "file:../../../../veilway-ui/packages/ui",
		"react": "^19.3.0",
		"react-dom": "^19.3.0"
	},
	"devDependencies": {
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"typescript": "^5.9.3",
		"vite": "^8.3.4"
	}
}
