{
	"name": "@veilway/sdk",
	"version": "0.1.0",
	"private": true,
	"description": "Typed client for the Veilway control API",
	"license": "Apache-2.0",
	"type": "module",
	"main": "dist/src/index.js",
	"types": "dist/src/index.d.ts",
	"files": [
		"dist/src"
	],
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"generate": "openapi-typescript ../../crates/veilway-api/openapi.json -o src/schema.ts",
		"check": "openapi-typescript ../../crates/veilway-api/openapi.json -o /tmp/veilway-sdk-schema.ts && cmp src/schema.ts /tmp/veilway-sdk-schema.ts && tsc --noEmit",
		"build": "tsc",
		"test": "tsc && node --test \"dist/test/*.test.js\""
	},
	"devDependencies": {
		"@types/node": "^22.20.5",
		"openapi-typescript": "^7.13.0",
		"typescript": "^5.9.3",
		"undici": "^8.11.2"
	}
}
