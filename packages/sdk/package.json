{
	"name": "@veilway/sdk",
	"version": "0.2.9-alpha",
	"description": "Typed client for the Veilway control API",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/veilway-project/veilway.git",
		"directory": "packages/sdk"
	},
	"homepage": "https://github.com/veilway-project/veilway/tree/main/packages/sdk",
	"keywords": ["veilway", "vpn", "wireguard", "control-api"],
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"type": "module",
	"main": "dist/src/index.js",
	"types": "dist/src/index.d.ts",
	"files": [
		"dist/src"
	],
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"generate": "openapi-typescript ../../crates/veilway-api/openapi.json -o src/schema.ts",
		"check": "openapi-typescript ../../crates/veilway-api/openapi.json -o /tmp/veilway-sdk-schema.ts && cmp src/schema.ts /tmp/veilway-sdk-schema.ts && tsc --noEmit",
		"build": "tsc",
		"test": "tsc && node --test \"dist/test/*.test.js\""
	},
	"devDependencies": {
		"@types/node": "^26.6.5",
		"openapi-typescript": "^7.13.0",
		"typescript": "^5.9.3",
		"undici": "^8.11.2"
	}
}
