{
	"name": "@veilway/ui",
	"version": "0.1.0",
	"private": true,
	"description": "Design tokens, glass material, components and themes for the Veilway panel and clients",
	"license": "Apache-2.0",
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./styles.css": "./src/styles/index.css",
		"./theme": "./src/theme/index.ts"
	},
	"engines": {
		"node": ">=22.18"
	},
	"scripts": {
		"dev": "vite --host 0.0.0.0",
		"build": "vite build",
		"preview": "vite preview --host 0.0.0.0",
		"tokens": "node scripts/tokens.ts",
		"check": "tsc --noEmit",
		"test": "node --test \"test/*.test.ts\""
	},
	"dependencies": {
		"@fontsource-variable/atkinson-hyperlegible-mono": "^5.3.0",
		"@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
		"@fontsource-variable/vazirmatn": "^5.3.0",
		"@veilway/i18n": "file:../i18n",
		"d3-scale": "^4.0.2",
		"d3-shape": "^3.2.0",
		"radix-ui": "^1.8.1",
		"react": "^19.3.0",
		"react-dom": "^19.3.0"
	},
	"devDependencies": {
		"@types/d3-scale": "^4.0.9",
		"@types/d3-shape": "^3.2.0",
		"@types/node": "^22.20.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"typescript": "^5.9.3",
		"vite": "^8.3.4"
	}
}
